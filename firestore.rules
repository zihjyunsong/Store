rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // admin 判斷：登入者的 token 帶有 admin 自訂宣告（custom claim）
    // 用 tools/set-admin.js 設定，前端無法偽造
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 使用者資料（最愛、購物車）：只能讀寫自己的
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 教學網站權限清單：只能讀自己的，不能從前端寫
    match /access/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // 商品：任何人都可以看，但只有 admin 能改價格／上下架
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 訂單：只能讀「自己的」訂單；前端完全不能寫
    // 建立與更新訂單只能透過後端（Cloud Functions 的 Admin SDK 不受規則限制）
    // 所以沒有任何人能從前端把 status 改成 paid
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
